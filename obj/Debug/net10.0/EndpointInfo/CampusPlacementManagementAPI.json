  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "required": [
          "currentPassword",
          "newPassword",
          "confirmPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "minLength": 8,
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        }
      },
      "CollegeCreateDto": {
        "required": [
          "collegeName",
          "collegeCode",
          "address",
          "officialEmail",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "collegeName": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "collegeCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "universityName": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "address": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "officialEmail": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "website": {
            "maxLength": 255,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          }
        }
      },
