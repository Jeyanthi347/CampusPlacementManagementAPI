              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentEnrollDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StudentEnrollDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Students": {
