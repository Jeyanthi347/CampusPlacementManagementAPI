        "type": "object",
        "properties": {
          "companyName": {
            "maxLength": 200,
            "type": "string"
          },
          "companyEmail": {
            "maxLength": 255,
            "type": "string"
          },
          "website": {
            "maxLength": 255,
            "type": [
              "null",
