  "components": {
    "schemas": {
      "StudentEnrollDto": {
        "required": [
          "fullName",
          "email",
          "phoneNumber",
          "registerNumber",
          "department",
          "degree"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "registerNumber": {
            "maxLength": 50,
            "type": "string"
          },
          "department": {
            "maxLength": 100,
            "type": "string"
          },
          "degree": {
            "maxLength": 100,
            "type": "string"
          },
          "graduationYear": {
            "maximum": 2100,
            "minimum": 2000,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cgpa": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "activeBacklogs": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resumeUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StudentUpdateDto": {
        "required": [
          "fullName",
          "phoneNumber",
          "department",
          "degree"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "department": {
            "maxLength": 100,
            "type": "string"
          },
          "degree": {
            "maxLength": 100,
            "type": "string"
          },
          "graduationYear": {
            "maximum": 2100,
            "minimum": 2000,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cgpa": {
            "maximum": 10,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "activeBacklogs": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resumeUrl": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
